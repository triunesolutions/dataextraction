# Copy this file to ".env" and fill in your Groq API key.
# (setup.bat does this for you automatically.)

# Backend that turns the PDF text into structured fields:
#   groq   = Groq Cloud API (default, no local model download)
#   ollama = a local Ollama model (fully offline)
MODEL_BACKEND=groq

# ---- Groq Cloud settings (used when MODEL_BACKEND=groq) ----
# Get a free key at:  https://console.groq.com/keys
GROQ_API_KEY=gsk_paste_your_key_here
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---- Local Ollama settings (used when MODEL_BACKEND=ollama) ----
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_NUM_CTX=8192

# ---- Storage & extraction tuning ----
DB_PATH=hvac.db
SCHEDULE_KEYWORDS=SCHEDULE,MANUFACTURER,MODEL NO,MODEL #
MECH_MARKERS=MECHANICAL,HVAC
RESTRICT_TO_MECHANICAL=true
COVER_MARKERS=COVER SHEET,TITLE SHEET,PROJECT TEAM,PROJECT DIRECTORY,CONSULTANTS,ARCHITECT OF RECORD,ENGINEER OF RECORD,SHEET INDEX
MIN_TEXT_CHARS=100
